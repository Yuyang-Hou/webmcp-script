{
  "name": "webmcp-script",
  "version": "0.4.0-beta.3",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node bridge/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "demo": "node scripts/demo.mjs",
    "test:browser": "pnpm test:ui && pnpm test:native-browser && pnpm test:catalog-browser",
    "test:catalog-browser": "node tests/catalog-browser.mjs",
    "test:native-browser": "node tests/native-bundle-browser.mjs",
    "bundle:native": "node scripts/bundle-native.mjs",
    "scripts": "node scripts/library.mjs",
    "check:spec": "openspec validate --all --strict",
    "pretest": "pnpm build",
    "test:ui": "pnpm build && node tests/ui-browser.mjs",
    "package": "node scripts/package.mjs",
    "test:package": "pnpm package && node tests/package.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/view": "^6.43.11",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "acorn": "8.18.0",
    "codemirror": "^6.0.2",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.58.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuyang-Hou/webmcp-script.git"
  }
}
